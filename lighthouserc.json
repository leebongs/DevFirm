{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3100",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://127.0.0.1:3100/",
        "http://127.0.0.1:3100/solutions",
        "http://127.0.0.1:3100/solutions/agents/construction",
        "http://127.0.0.1:3100/academy/courses",
        "http://127.0.0.1:3100/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "emulatedFormFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 1000000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
